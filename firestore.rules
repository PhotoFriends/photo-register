rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 合言葉から作ったキー（64桁の16進）を知っている端末だけが読み書きできる
    match /shops/{key}/{coll}/{id} {
      allow read: if key.matches('^[0-9a-f]{64}$');
      allow create, update: if key.matches('^[0-9a-f]{64}$')
        && coll in ['sales', 'meta']
        && request.resource.data.size() < 30;
      allow delete: if false;
    }
  }
}
